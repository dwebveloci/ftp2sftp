# Non-secret environment references only (RF-012 / section 12). ftp2sftp
# reads all of its actual configuration from a mounted YAML file (see
# configs/config.example.yaml); the variables below only tell the process
# where to find that file and, in Docker, are not credentials themselves.
#
# Real secrets (SFTP private key, FTP password hashes) are never read from
# environment variables. They live in files mounted read-only at runtime
# (see docs/security/security-model.md and docs/deployment/deployment-model.md).

# Path inside the container (or on the host, for a non-Docker run) to the
# gateway's YAML configuration file.
CONFIG_FILE=/app/config/config.yaml
