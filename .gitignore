# Build artifacts
/bin/
/dist/
*.exe
*.test
*.out

# Local Go tooling
/vendor/

# Dev-only secrets generated by deploy/docker/README.md — never commit key
# material, even for a throwaway local SFTP test server.
/deploy/docker/dev-keys/
/deploy/docker/known_hosts

# Local overrides
.env
*.local.yaml

# Personal Claude Code permission overrides (accumulated per-session
# approvals) — settings.json (team-shared policy) is versioned, this is not.
/.claude/settings.local.json

# Local pre-prod testing against a real remote SFTP target: real config,
# private keys, known_hosts and IPs — never commit this.
/pre-prod/

# IDE / OS noise
.idea/
.vscode/
*.swp
.DS_Store
*:Zone.Identifier
